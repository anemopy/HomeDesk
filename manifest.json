{
  "manifest_version": 3,
  "name": "HomeDesk",
  "version": "1.0.0",
  "description": "Your personalized new tab dashboard with custom shortcut grids.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
